# Copy this file to .env and fill in your values
# Usage: docker compose -f docker-compose.wsl.yml up -d

# Required: gateway auth token (generate with: openssl rand -hex 32)
OPENCLAW_GATEWAY_TOKEN=

# Data directory on WSL host (mapped to /home/node/.openclaw in container)
OPENCLAW_DATA_DIR=~/.bao

# Timezone
OPENCLAW_TZ=Asia/Ho_Chi_Minh

# Gateway bind mode: lan (default), loopback, or 0.0.0.0
OPENCLAW_GATEWAY_BIND=lan

# Port mapping (defaults)
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790

# Optional: allow insecure WebSocket from private LAN
# OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=1
